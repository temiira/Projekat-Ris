@model InformacioniSistemOnlineUcenje.Models.Napredak

<h2>Detalji napretka</h2>

<p><strong>Korisnik:</strong> @Model.Korisnik.Ime</p>
<p><strong>Kurs:</strong> @Model.Kurs.Naziv</p>
<p><strong>Procenat:</strong> @Model.Procenat %</p>
