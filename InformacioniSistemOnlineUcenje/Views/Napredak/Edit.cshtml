@model InformacioniSistemOnlineUcenje.Models.Napredak

@{
    ViewData["Title"] = "Uredi napredak";
}

<div class="container mt-4">
    <h2>Uredi napredak</h2>

    <form asp-action="Edit" method="post" class="col-md-6 mt-3">
        <input type="hidden" asp-for="NapredakID" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }

        <div class="form-group mb-3">
            <label class="form-label fw-bold">Korisnik (Učenik)</label>
            <select asp-for="KorisnikID" class="form-control form-select" asp-items="ViewBag.Korisnici"></select>
            <span asp-validation-for="KorisnikID" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-bold">Kurs</label>
            <select asp-for="KursID" class="form-control form-select" asp-items="ViewBag.Kursevi"></select>
            <span asp-validation-for="KursID" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-bold">Procenat (%)</label>
            <input asp-for="Procenat" type="number" min="0" max="100" class="form-control" />
            <span asp-validation-for="Procenat" class="text-danger"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-warning">Sačuvaj izmjene</button>
            <a asp-action="Index" class="btn btn-secondary">Nazad</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}