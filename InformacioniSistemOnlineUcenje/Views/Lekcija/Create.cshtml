@model InformacioniSistemOnlineUcenje.Models.Lekcija

@{
    ViewData["Title"] = "Dodaj lekciju";
}

<h2>DODAJ LEKCIJU</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Naziv"></label>
        <input asp-for="Naziv" class="form-control" />
        <span asp-validation-for="Naziv" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Sadrzaj"></label>
        <textarea asp-for="Sadrzaj" class="form-control"></textarea>
        <span asp-validation-for="Sadrzaj" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="KursID"></label>
        <select asp-for="KursID" class="form-control" asp-items="ViewBag.Kursevi">
            <option value="">-- Odaberi kurs --</option>
        </select>
        <span asp-validation-for="KursID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Upload slika (opciono)</label>
        <input type="file" name="SlikaFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">SAČUVAJ</button>
    <a asp-action="Index" class="btn btn-secondary">NAZAD</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
