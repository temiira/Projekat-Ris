@model InformacioniSistemOnlineUcenje.Models.Lekcija

@{
    ViewData["Title"] = "Uredi lekciju";
}

<h2>UREDI LEKCIJU</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="LekcijaID" />

    <div class="form-group">
        <label>Naziv</label>
        <input asp-for="Naziv" class="form-control" />
        <span asp-validation-for="Naziv" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Sadržaj</label>
        <textarea asp-for="Sadrzaj" class="form-control"></textarea>
        <span asp-validation-for="Sadrzaj" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Kurs</label>
        <select asp-for="KursID" asp-items="ViewBag.Kursevi" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Promijeni sliku (opciono)</label>
        <input type="file" name="SlikaFile" class="form-control" />
    </div>

    @if (!string.IsNullOrEmpty(Model.SlikaBase64))
    {
        <div class="form-group mt-3">
            <label>Trenutna slika:</label><br />
            <img src="data:image/png;base64,@Model.SlikaBase64" width="200" />
        </div>
    }

    <button type="submit" class="btn btn-success mt-3">SAČUVAJ</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">NAZAD</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
