@model InformacioniSistemOnlineUcenje.Models.Lekcija

@{
    ViewData["Title"] = "Obriši lekciju";
}

<h2>Obriši lekciju</h2>

<h4>Da li ste sigurni da želite obrisati ovu lekciju?</h4>

<div>
    <h5>@Model.Naziv</h5>
    <p>@Model.Sadrzaj</p>
    <form asp-action="Delete">
        <input type="hidden" asp-for="LekcijaID" />
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-controller="Kurs" asp-action="Details" asp-route-id="@Model.KursID" class="btn btn-secondary">Nazad</a>
    </form>
</div>
