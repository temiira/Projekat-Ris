@model InformacioniSistemOnlineUcenje.Models.Korisnik

@{
    ViewData["Title"] = "Prijava";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 shadow p-4 bg-white" style="border-radius: 12px;">
            <h2 class="fw-bold mb-4 text-center text-primary">🔐 Prijava na sistem</h2>

            <form asp-controller="Account" asp-action="Login" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger pb-0">
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    </div>
                }

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Email adresa</label>
                    <input type="email" name="Email" id="Email" class="form-control" placeholder="unesite@email.com" required />
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Lozinka</label>
                    <input type="password" name="Lozinka" id="Lozinka" class="form-control" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Prijavi se</button>

                <p class="text-center mt-3 mb-0 text-muted small">
                    Nemate kreiran račun? <a asp-controller="Account" asp-action="Register" class="text-decoration-none">Registrujte se besplatno</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}