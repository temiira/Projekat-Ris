@model IEnumerable<InformacioniSistemOnlineUcenje.Models.Kurs>

@{
    ViewData["Title"] = "Kursevi";
}

<div class="container mt-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-light text-dark">Katalog kurseva</h2>
        @if (ViewBag.PrikažiKreiraj == true)
        {
            <a asp-action="Create" class="btn btn-outline-primary btn-sm rounded-pill px-3">+ Novi Kurs</a>
        }
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group input-group-sm">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control rounded-pill-start bg-light border-0 px-3" placeholder="Pretraži kurseve..." />
            <button type="submit" class="btn btn-dark rounded-pill-end px-4">Traži</button>
        </div>
    </form>

    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-2 bg-white">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title fw-normal text-dark">@item.Naziv</h5>
                            <p class="card-text text-muted small mt-2">@item.Opis</p>
                        </div>

                        <div class="text-end mt-3 pt-2 border-top border-light">
                            <a asp-action="Details" asp-route-id="@item.KursID" class="btn btn-light btn-sm rounded-pill px-3">
                                Detalji
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>