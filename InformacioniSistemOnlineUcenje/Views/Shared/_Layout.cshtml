<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Informacioni Sistem Online Učenje</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/lux/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">IS ONLINE UČENJE</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarColor01">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Početna</a>
                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Kurs" asp-action="Index">Kursevi</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Profil" asp-action="Index">Moj Profil</a>
                        </li>

                        @* Opcije specifične za Učenika *@
                        @if (User.IsInRole("Ucenik"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Upis" asp-action="MojiKursevi">Moji kursevi</a>
                            </li>
                        }

                        @* Opcije specifične za Nastavnika i Admina *@
                        @if (User.IsInRole("Nastavnik") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Kurs" asp-action="Create">Kreiraj Kurs</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Lekcija" asp-action="Index">Lekcije</a>
                            </li>
                        }

                        @* Opcije isključivo za Admina *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Upravljanje Korisnicima</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Izvjestaji">Izvještaji sistema</a>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav ms-auto">
                    @if (User.Identity == null || !User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Prijava</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">Registracija</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="navbar-text me-3 text-light">👋 @User.Identity.Name</span>
                        </li>
                        <li class="nav-item">
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm mt-1">Odjava</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5 py-3 bg-light text-center">
        <div class="container">
            &copy; 2026 - Informacioni Sistem Online Učenje | Sva prava zadržana
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>