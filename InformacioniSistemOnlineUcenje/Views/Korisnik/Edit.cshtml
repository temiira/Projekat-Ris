@model InformacioniSistemOnlineUcenje.Models.Korisnik

@{
    ViewData["Title"] = "Edit";
}

<h1>Uredi korisnika</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="KorisnikID" />

            <div class="form-group">
                <label asp-for="Ime" class="control-label"></label>
                <input asp-for="Ime" class="form-control" />
                <span asp-validation-for="Ime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Prezime" class="control-label"></label>
                <input asp-for="Prezime" class="form-control" />
                <span asp-validation-for="Prezime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Lozinka" class="control-label"></label>
                <input asp-for="Lozinka" type="password" class="form-control" />
                <span asp-validation-for="Lozinka" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Uloga" class="control-label"></label>
                <select asp-for="Uloga" class="form-control">
                    <option value="Admin">Admin</option>
                    <option value="Nastavnik">Nastavnik</option>
                    <option value="Korisnik">Korisnik</option>
                </select>
                <span asp-validation-for="Uloga" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DatumRegistracije" class="control-label"></label>
                <input asp-for="DatumRegistracije" type="date" class="form-control" />
                <span asp-validation-for="DatumRegistracije" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Sačuvaj" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Nazad</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
