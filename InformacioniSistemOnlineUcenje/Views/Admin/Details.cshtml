@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Detalji korisnika";
}

<h2 class="mb-4">👤 Detalji korisnika</h2>

<div class="card shadow p-4">

    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>ID:</strong> @Model.Id</p>

    <h4 class="mt-4">Uloge</h4>
    <ul>
        @foreach (var r in (List<string>)ViewBag.Roles)
        {
            <li>@r</li>
        }
    </ul>

    <hr />

    <h4>Promjena uloge</h4>
    <form asp-action="ChangeRole" method="post">

        <input type="hidden" name="userId" value="@Model.Id" />

        <select name="role" class="form-select mb-3">
            <option value="Ucenik">Učenik</option>
            <option value="Nastavnik">Nastavnik</option>
            <option value="Admin">Admin</option>
        </select>

        <button class="btn btn-primary">Sačuvaj</button>
    </form>
</div>
