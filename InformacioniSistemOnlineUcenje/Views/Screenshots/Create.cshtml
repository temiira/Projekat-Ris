@model InformacioniSistemOnlineUcenje.Models.Screenshot

@{
    ViewData["Title"] = "Dodaj screenshot";
}

<div class="container mt-4">
    <h2>Dodavanje screenshota</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-6 mt-3">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }

        <div class="form-group mb-3">
            <label class="form-label fw-bold">Odaberite sliku (fajl)</label>
            <input asp-for="DatotekaSlike" type="file" class="form-control" accept="image/*" required />
            <span asp-validation-for="DatotekaSlike" class="text-danger"></span>
            <small class="text-muted d-block mt-1">Sistem će automatski konvertovati sliku u bazu podataka.</small>
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-bold">Kurs</label>
            <select asp-for="KursID" class="form-control form-select"
                    asp-items="@(new SelectList(ViewBag.Kursevi, "KursID", "Naziv"))" required>
                <option value=""> --- Odaberite kurs --- </option>
            </select>
            <span asp-validation-for="KursID" class="text-danger"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Sačuvaj</button>
            <a asp-action="Index" class="btn btn-secondary">Nazad</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}