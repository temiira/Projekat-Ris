@model InformacioniSistemOnlineUcenje.Models.Screenshot

<h2>Obriši screenshot</h2>

<p>Da li ste sigurni da želite obrisati ovaj screenshot?</p>

@if (!string.IsNullOrEmpty(Model.Opis))
{
    <img src="data:image/png;base64,@Model.Opis" width="300" />
}

<form asp-action="Delete">
    <input type="hidden" asp-for="ScreenshotID" />
    <button type="submit" class="btn btn-danger">Obriši</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>
